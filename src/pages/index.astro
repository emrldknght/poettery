---
import '../../style.css';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { getAllMdFiles } from '../utils/getAllMdFiles.js';

const contentDir = './content';
const allFiles = getAllMdFiles(contentDir);

// Группируем
const rootFiles = [];
const groups = {};

for (const file of allFiles) {
  const relativePath = path.relative(contentDir, file);
  const parts = relativePath.split(path.sep);
  const slug = relativePath.replace(/\.md$/, '').replace(/\\/g, '/');

  // Читаем frontmatter для названия
  const raw = fs.readFileSync(file, 'utf-8');
  const { data } = matter(raw);
  const title = data.title || slug.split('/').pop();

  if (parts.length === 1) {
    rootFiles.push({ slug, title });
  } else {
    const folder = parts[0];
    if (!groups[folder]) groups[folder] = [];
    groups[folder].push({ slug, title });
  }
}
---

<html>
<head>
  <meta charset="UTF-8">
  <title>poettery</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<h1>poettery</h1>

<!-- Корневые стихи -->
<h2>Стихи</h2>
<ul>
  {rootFiles.map(({ slug, title }) => (
      <li><a href={`/poettery/${slug}`}>{title}</a></li>
  ))}
</ul>

<!-- Папки -->
{Object.keys(groups).sort().map(folder => (
    <>
      <h2>{folder}</h2>
      <ul>
        {groups[folder].map(({ slug, title }) => (
            <li><a href={`/poettery/${slug}`}>{title}</a></li>
        ))}
      </ul>
    </>
))}
</body>
</html>