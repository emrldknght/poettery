---
import '../../style.css';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  function getAllMdFiles(dir) {
    const files = [];
    const entries = fs.readdirSync(dir, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        files.push(...getAllMdFiles(fullPath));
      } else if (entry.name.endsWith('.md')) {
        files.push(fullPath);
      }
    }
    return files;
  }

  const contentDir = './content';
  const mdFiles = getAllMdFiles(contentDir);

  // Возвращаем slug как строку, а не массив
  return mdFiles.map(file => {
    const relativePath = path.relative(contentDir, file);
    const slug = relativePath.replace(/\.md$/, '').replace(/\\/g, '/');
    return { params: { slug } }; // slug - это строка
  });
}

// Для [...slug] параметр приходит как массив, даже если мы передали строку
const { slug } = Astro.params;
const slugPath = Array.isArray(slug) ? slug.join('/') : slug;
const content = fs.readFileSync(`./content/${slugPath}.md`, 'utf-8');
---

<html>
<head>
  <meta charset="UTF-8">
  <title>{slugPath} | poettery</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="nav">
  <a href="/poettery/">← Назад</a>
</div>
<div class="poem">
  <pre>{content}</pre>
</div>
</body>
</html>