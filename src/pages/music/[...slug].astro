---
import '../../../style.css';
import '../../../tabs.css';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
import { getAllMdFiles } from '../../utils/getAllMdFiles.js';

export async function getStaticPaths() {
  const contentDir = './content';
  const allFiles = getAllMdFiles(contentDir);

  // Только музыка (layout: music)
  const musicFiles = allFiles.filter(file => {
    const raw = fs.readFileSync(file, 'utf-8');
    const { data } = matter(raw);
    return data.layout === 'music';
  });

  return musicFiles.map(file => {
    const relativePath = path.relative(contentDir, file);
    const slug = relativePath.replace(/\.md$/, '').replace(/\\/g, '/');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const slugPath = Array.isArray(slug) ? slug.join('/') : slug;
const filePath = `./content/${slugPath}.md`;
const fileContent = fs.readFileSync(filePath, 'utf-8');

const { data, content } = matter(fileContent);
const title = data.title || slugPath;
const htmlContent = await marked(content);

// Проверяем файл табов
const gp5File = data.file ? path.join(process.cwd(), data.file) : null;
const gp5Exists = gp5File ? fs.existsSync(gp5File) : false;

// Читаем текст песни
let lyricsContent = null;
if (data.lyrics) {
  try {
    const lyricsPath = path.join(process.cwd(), data.lyrics);
    if (fs.existsSync(lyricsPath)) {
      const lyricsRaw = fs.readFileSync(lyricsPath, 'utf-8');
      const { content: lyricsMd } = matter(lyricsRaw);
      lyricsContent = await marked(lyricsMd);
    }
  } catch (e) {
    console.error('Error loading lyrics:', e);
  }
}
---

<html>
<head>
  <meta charset="UTF-8">
  <title>{title} | poettery</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/tabs.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@coderline/alphatab@latest/dist/alphaTab.min.css" />
</head>
<body>
<div class="nav">
  <a href="/poettery/">← Назад</a>
</div>

<div class="poem">
  <h1>{title}</h1>
  <div set:html={htmlContent} />
</div>

{lyricsContent && (
    <div class="poem">
      <h2>Текст</h2>
      <div set:html={lyricsContent} />
    </div>
)}

{gp5Exists && (
    <>
      <div class="player-controls">
        <button id="playPauseBtn" disabled>▶ Play</button>
        <button id="stopBtn" disabled>⏹ Stop</button>
      </div>

      <div id="track-wrapper">
        <div id="alphaTabContainer" data-file={data.file}></div>
      </div>

      <script type="module" src="/tabs.js"></script>
    </>
)}
</body>
</html>