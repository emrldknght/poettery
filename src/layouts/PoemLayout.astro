---
export interface Props {
  title: string;
  content: string;
  date?: string;
}

const { title, content, date } = Astro.props;
---

<html>
<head>
  <meta charset="UTF-8">
  <title>{title} | poettery - poem layer</title>

</head>
<body class="poem-layout--body">
<div class="nav">
  <a href="/poettery/">← Назад</a>
</div>
<div class="poem">
  <div class="poem--header">
    <h1>
      {title}
    </h1>
    {date && (<b>({date})</b>)}
    <button id="copyBtn">📋 Копировать</button>
  </div>
  <div id="contentRoot" set:html={content} />
</div>
<script is:inline src="/poettery/copy-poem.js"></script>
</body>
</html>